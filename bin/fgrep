# abstract: Interactive grep using fzf
#
# Based on the original pkgsearch at
# https://raw.githubusercontent.com/DanielFGray/fzf-scripts/master/igr
#
# Defaults {{{1
#
CONTEXT=3 # default lines of grep context

# Documentation {{{1
#
VERSION=1.0
print_version() { # {{{2
    cat <<END
$(basename "$0") $VERSION
Copyright (C) 2026 Orion Arts
Copyright (C) 2016 Daniel F. Gray
License GPLv3+: GNU GPL version 3 or later <https://gnu.org/licenses/gpl.html>.
This is free software: you are free to change and redistribute it.
There is NO WARRANTY, to the extent permitted by law.

Written by Jeremy Brubaker.
END
} >&2

print_help() { # {{{2
    cat <<END
Usage: $(basename "$0") [OPTIONS] [QUERY]

Interactive grep using fzf. The default action is to print selected files to stdout

  -e        edit selected files in \$EDITOR
  -c [CMD]  pass selected files to CMD
  -C [NUM]  display NUM lines of context (Default: $CONTEXT)
  -h   	    display this help and exit
  -V        output version information and exit
END
} >&2

# Process options {{{1
#
if ! command -v fzf >/dev/null; then
    printf '%s\n' 'fzf not found!' >&2
    exit 1
fi

edit=false
unset command
while getopts ":ec:C:hV" opt; do
    case $opt in
        e)  edit=true; unset command ;;
        c)  command=$OPTARG; unset edit ;;
        C)  CONTEXT=$OPTARG ;;
        h)  print_help; exit ;;
        V)  print_version; exit ;;
        \?) print_invalid "-$OPTARG"; print_help; exit 1 ;;
        :)  print_noarg "$OPTARG"; print_help; exit 1 ;;
    esac
done
shift $((OPTIND-1))
OPTIND=1

if [ "$#" -ne 1 ]; then
    printf 'Search for what?\n' >&2
    print_help
    exit 1
fi

# Main {{{1
#
if command -v rg /dev/null; then
    search='rg --color=always'
else
    search='grep -R --color=always'
fi

files=$(fzf --query="$*" \
    --delimiter=: \
    --accept-nth=1 \
    --ansi \
    --multi \
    --bind="change:reload:$search {q}" \
    --bind="start:reload:$search {q}" \
    --preview="[ -n '{1}' ] && grep -C$CONTEXT {q} {1}")

if [ "$edit" = true ]; then
    $EDITOR $files
elif [ -n "$command" ]; then
    $command $files
else
    printf -- '%s\n' "$files"
fi

