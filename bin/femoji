# abstract: use fzf to select emoji
#
curl -s https://unicode.org/Public/emoji/latest/emoji-test.txt |
    sed -e '/^#/d' \
        -e '/^$/d' \
        -e 's/^.*# //' \
        -e 's/E[^ ]* //' |
    fzf --ansi --delimiter=' ' --accept-nth=1 |
    tr -d '\n' |
    xclip -in -selection clipboard

xclip -out -selection clipboard
echo

