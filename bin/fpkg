VERSION=1.0
print_version() { # {{{2
    cat <<END
$(basename "$0") $VERSION
Copyright (C) 2026 Orion Arts
Copyright (C) 2016 Daniel F. Gray
License GPLv3+: GNU GPL version 3 or later <https://gnu.org/licenses/gpl.html>.
This is free software: you are free to change and redistribute it.
There is NO WARRANTY, to the extent permitted by law.

Written by Jeremy Brubaker.
END
} >&2

print_help() { # {{{2
    cat <<END
Usage: $(basename "$0") [OPTIONS] [QUERY]

Use fzf to select and install packages

  -h   	    display this help and exit
  -V        output version information and exit
END
} >&2

# Process options {{{1
#
die() {
    [ -n "$*" ] && printf '%s\n' "$*" >&2
    exit 1
}

command -v fzf >/dev/null || die "fzf not found!"

unset remove

print_noarg()   { printf '%s requires an argument\n' "$1"; } >&2
print_invalid() { printf 'Invalid option: %s\n' "$1"; } >&2
while getopts ":RhV" opt; do
    case $opt in
        R)  remove=true ;;
        h)  print_help; exit ;;
        V)  print_version; exit ;;
        \?) print_invalid "-$OPTARG"; print_help; exit 1 ;;
        :)  print_noarg "$OPTARG"; print_help; exit 1 ;;
    esac
done
shift $((OPTIND-1))
OPTIND=1

# Functions {{{1
#
c_reset='[0m'
c_green='[32m'

fzf() { # {{{2
    command fzf \
        --exact \
        --delimiter=: \
        --accept-nth='{1}' \
        --no-sort \
        --multi \
        --ansi \
        --preview-window=hidden \
        --bind='Ctrl-/:toggle-preview' \
        --header='TAB: select multiple packages, Ctrl-/: toggle package info' \
        "$@"
}

do_it() { # {{{2
    pkgs=$(paste -sd' ' -)

    [ -z "$pkgs" ] && return

    count=$(( $(echo "$pkgs" | tr -dc ' ' | wc -m) + 1))

    if [ -z "$remove" ]; then
        action=Installing
    else
        action=Uninstalling
    fi

    printf '%s %s packages: %s\n' "$action" "$count" "$pkgs"
    echo

    unset sudo
    [ $(id -u) -ne 0 ] && sudo=sudo

    # Read yes or no from TTY
    $sudo $1 $pkgs </dev/tty
}

do_apt() { # {{{2
    remove=$1; shift
    if [ -z "$remove" ]; then
        cmd='apt-cache-search ".*"'
        preview='p={}; p="${p%%:*}"; apt-cache show "$p"'
        action=install
    else
        cmd='apt list --installed 2>/dev/null | grep -F "[installed]"'
        preview='apt info {1}'
        action=remove
    fi

    $cmd |
    sort |
    sed -e "s/^/$c_green/" -e "s/ -/$c_reset:/" |
    fzf --query="$*" \
        --preview=$preview |
    do_it "apt $action"
}

do_dnf() { # {{{2
    remove=$1; shift
    if [ -z "$remove" ]; then
        action=install
        cache=--cacheonly
        userinstalled=
    else
        action=remove
        cache=
        userinstalled=--userinstalled
    fi

    dnf --quiet $cacheonly \
        repoquery $userinstalled --qf "$c_green%{name}$c_reset: %{summary}\n" \* |
    sort |
    fzf --query="$*" \
        --preview='p={}; p="${p%%:*}"; dnf -q info "$p"' |
    do_it "dnf $action"
}

# Main {{{1
#
  if command -v dnf >/dev/null; then
    do_dnf "$remove" "$*"
elif command -v apt-get >/dev/null; then
    do_apt "$remove" "$*"
else
    die 'Unsupported distribution!'
fi

